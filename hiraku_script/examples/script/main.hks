print("Hello, World")

enum Foo {
    foo(String),
    bar
}

fn test(value: Foo) -> String? {
    when value {
        .foo(name) -> "foo, ${name}"
        .bar -> null
    }
}

fn identity<T>(value: T) -> T { value }

let gr: Foo = .foo("222")

when test(gr) {
    .some(v) -> { print(v) },
    .none -> panic("x")
}

print(test(gr) ?: "xxx")
let a = identity("ww")
print(a)

let name: Optional<String> = .some("bar")
print(name ?: "f")

let result: Result<Int, String> = .success(67)
when result {
    .success(value) -> { print(value.toString()) }
    .error(message) -> { print(message) }
}

var index = 0
while index < 3 {
    print("Iteration ${index}")
    index += 1
}

struct TestFoo {
    name: String?
}

protocol Test { fn test(self) -> Unit }

extend TestFoo: Test {
    fn test(self) { print("name: ${self.name ?: "no way"}") }
}

extend TestFoo: Colon<String> {
    type Output = Unit

    fn colon(self, rhs: String) {
        self.test()
        print("rhs: ${rhs}")
    }
}

fn what<T: Test>(t: T) { t.test() }

let s: TestFoo = .{ name: "some name" }

s: "123"

what(s)

enum TestEnum {
    a(Int),
    b(Float),
    c(String)
}

extend TestEnum: Test {
    fn test(self) {
        let s = when self {
            .a(i) -> i.toString(),
            .b(f) -> f.toString(),
            .c(s) -> s
        }

        print(s)
    }
}

extend TestEnum {
    fn someStatic() -> Self { .a(12) }
}

let sa: TestEnum = .someStatic()

struct MyFoo { a: Int }

extend MyFoo { 
    let instance: MyFoo = .{ a: 1 }
    var staticCalc: Int {
        get() { 12 }
        set(newVal) { print(newVal.toString()) }
    }

    var nonStaticCalc: Int {
        get(self) { self.a }
        set(self, newVal) { self.a = newVal }
    }
}

let aw = MyFoo.staticCalc

MyFoo.staticCalc = 2211