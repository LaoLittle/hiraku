type Unit = ()

extend UInt {
    fn toUInt(self) -> UInt { self }
    @inline
    fn toString(self) -> String { intrinsics.toString(self) }
    fn toFloat(self) -> Float { self as Float }
    fn toInt(self) -> Int { self as! Int }
}

extend UInt: Add<UInt> {
    type Output = UInt
    @inline
    fn add(self, rhs: UInt) -> Output { intrinsics.uint.add(self, rhs) }
}

extend UInt: Subtract<UInt> {
    type Output = UInt
    @inline
    fn subtract(self, rhs: UInt) -> Output { intrinsics.uint.subtract(self, rhs) }
}

extend UInt: Multiply<UInt> {
    type Output = UInt
    @inline
    fn multiply(self, rhs: UInt) -> Output { intrinsics.uint.multiply(self, rhs) }
}

extend UInt: Divide<UInt> {
    type Output = UInt
    @inline
    fn divide(self, rhs: UInt) -> Output { intrinsics.uint.divide(self, rhs) }
}

extend UInt: Equal<UInt> {
    type Output = Bool
    @inline
    fn equal(self, rhs: UInt) -> Output { intrinsics.uint.equal(self, rhs) }
}

extend UInt: NotEqual<UInt> {
    type Output = Bool
    @inline
    fn notEqual(self, rhs: UInt) -> Output { intrinsics.uint.notEqual(self, rhs) }
}

extend UInt: Less<UInt> {
    type Output = Bool
    @inline
    fn less(self, rhs: UInt) -> Output { intrinsics.uint.less(self, rhs) }
}

extend UInt: LessEqual<UInt> {
    type Output = Bool
    @inline
    fn lessEqual(self, rhs: UInt) -> Output { intrinsics.uint.lessEqual(self, rhs) }
}

extend UInt: Greater<UInt> {
    type Output = Bool
    @inline
    fn greater(self, rhs: UInt) -> Output { intrinsics.uint.greater(self, rhs) }
}

extend UInt: GreaterEqual<UInt> {
    type Output = Bool
    @inline
    fn greaterEqual(self, rhs: UInt) -> Output { intrinsics.uint.greaterEqual(self, rhs) }
}

protocol Colon<Rhs> {
    type Output
    fn colon(self, rhs: Rhs) -> Self.Output
}

protocol Negate {
    type Output
    fn negate(self) -> Output
}

protocol Not {
    type Output
    fn not(self) -> Output
}

extend Int: Negate {
    type Output = Int
    @inline
    fn negate(self) -> Output { intrinsics.int.negate(self) }
}

extend Float: Negate {
    type Output = Float
    @inline
    fn negate(self) -> Output { intrinsics.float.negate(self) }
}

extend Bool: Not {
    type Output = Bool
    @inline
    fn not(self) -> Output { intrinsics.bool.not(self) }
}

enum Optional<T> {
    some(T),
    none,
}

enum Result<T, E> {
    success(T),
    error(E),
}

@trackCaller
fn panic(message: String) -> Never { intrinsics.panic(message) }
@trackCaller
fn unreachable() -> Never { panic("entered unreachable code") }
@trackCaller
fn todo() -> Never { panic("not yet implemented") }

extend Float {
    fn toUInt(self) -> UInt { self as! UInt }
    @inline
    fn toString(self) -> String { intrinsics.toString(self) }
    fn toFloat(self) -> Float { self }
    @inline
    fn toInt(self) -> Int { intrinsics.floatToInt(self) }
}

extend Int {
    fn toUInt(self) -> UInt { self as! UInt }
    @inline
    fn toString(self) -> String { intrinsics.toString(self) }
    @inline
    fn toFloat(self) -> Float { intrinsics.intToFloat(self) }
    fn toInt(self) -> Int { self }
}

extend Bool {
    @inline
    fn toString(self) -> String { intrinsics.toString(self) }
}

extend String {
    fn toString(self) -> String { self }
}

// Primitive operator contracts. Implementations remain script-owned.

protocol Add<Rhs> {
    type Output
    fn add(self, rhs: Rhs) -> Self.Output
}

protocol Subtract<Rhs> {
    type Output
    fn subtract(self, rhs: Rhs) -> Self.Output
}

protocol Multiply<Rhs> {
    type Output
    fn multiply(self, rhs: Rhs) -> Self.Output
}

protocol Divide<Rhs> {
    type Output
    fn divide(self, rhs: Rhs) -> Self.Output
}

protocol Equal<Rhs> {
    type Output
    fn equal(self, rhs: Rhs) -> Self.Output
}

protocol NotEqual<Rhs> {
    type Output
    fn notEqual(self, rhs: Rhs) -> Self.Output
}

protocol Less<Rhs> {
    type Output
    fn less(self, rhs: Rhs) -> Self.Output
}

protocol LessEqual<Rhs> {
    type Output
    fn lessEqual(self, rhs: Rhs) -> Self.Output
}

protocol Greater<Rhs> {
    type Output
    fn greater(self, rhs: Rhs) -> Self.Output
}

protocol GreaterEqual<Rhs> {
    type Output
    fn greaterEqual(self, rhs: Rhs) -> Self.Output
}

