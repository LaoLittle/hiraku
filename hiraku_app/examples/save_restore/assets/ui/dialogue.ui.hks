import ui.widgets.*

screen {
    column {
        text($dialogueTitle).pulse(1.4)
        text($dialogueLine)

        row {
            button { text("Quick Save") }.action("storage.save.save_restore_example")
            button { text("Quick Load") }.action("storage.load.save_restore_example")
            button("continue") { text("Continue") }
        }
            .size(.rel(70, 16))
            .gap(12)
    }
        .size(.rel(72, 48))
        .gap(18)
}
    .overlay(0.05, 0.07, 0.12, 0.96)
