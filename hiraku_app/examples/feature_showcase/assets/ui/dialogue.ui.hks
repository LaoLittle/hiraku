import ui.widgets.*

canvas {
    column {
        text(${dialogue.speaker})
            .fontSize(24)
            .color(0.95, 0.72, 0.38, 1.0)
            .visible(${dialogue.speaker != ""})

        text(${dialogue.text.prefix(dialogue.revealedCharacters)})
            .fontSize(30)
            .color(0.96, 0.97, 1.0, 1.0)

        button { text("Continue") }
            .action("story.next")
            .enabled(${dialogue.canAdvance})
    }
        .at(.rel(8, 66))
        .size(.rel(84, 28))
        .padding(24)
        .gap(12)
        .surface(0.035, 0.055, 0.11, 0.94)
        .visible(${dialogue.visible})
}
